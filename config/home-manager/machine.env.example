# Per-machine settings, written to machine.env (gitignored) by bootstrap.sh.
# Keep the quotes: the file is read both as a shell env file and as TOML.
DOTFILES_USER="zaidb"
DOTFILES_DIR="/home/zaidb/dotfiles"
# One of: macos, wsl, ubuntu
DOTFILES_HOST="wsl"
# Optional, defaults to "true": the Claude Agents Stream Deck plugin (WSL only).
# DOTFILES_STREAMDECK="false"
